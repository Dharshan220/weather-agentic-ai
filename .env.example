# --- LLM provider (OpenAI-compatible API: Groq, OpenAI, Ollama, etc.) ---
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.6-27b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120

# --- Locations to monitor (JSON array of {name, lat, lon}) ---
WEATHER_LOCATIONS=[{"name":"Chennai","lat":13.0827,"lon":80.2707},{"name":"Bengaluru","lat":12.9716,"lon":77.5946,"use_llm":false},{"name":"Adhanur, Urapakkam","lat":12.8732,"lon":80.0466,"use_llm":true}]

# --- Scheduling ---
SCHEDULE_INTERVAL_MINUTES=30

# --- Risk thresholds ---
RAIN_MM_THRESHOLD=20
HEAT_C_THRESHOLD=35
WIND_KMH_THRESHOLD=40
ALERT_THRESHOLD=HIGH
ALERT_COOLDOWN_HOURS=6

# --- Email (SMTP). Set SMTP_ENABLED=true and fill creds to send real email.
# Demo mode (false) logs the alert instead of sending.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_TO=

# --- Daily summary email (set SMTP_ENABLED=true to actually send) ---
DAILY_SUMMARY_ENABLED=false
DAILY_SUMMARY_TIMES=07:00,21:00
TIMEZONE=Asia/Kolkata

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
DB_PATH=weather.db